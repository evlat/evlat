#!/bin/sh
# A fake `ssh` for the tunnel tests and the demo. It plays the three calls a
# machine's tunnel makes and never reaches a server:
#
#   the master (`-M`)    asks its askpass the way the real one does — the
#                        prompt alone in argv[1], the helper `$SSH_ASKPASS`,
#                        its stdout the answer and its exit code whether there
#                        is one — then runs the remote command here: it prints
#                        the channel's mark and holds its stdin open like the
#                        real remote `cat`
#   a call (`… sh -s`)   runs the script on stdin under `sh`, with
#                        `$FAKE_SSH_HOME` as its home: the probe, the reading,
#                        the installs, all against a temporary folder
#   a forward (`-O`)     the channel's forward over the master: recorded, and
#                        made unless `FAKE_SSH_FORWARD=refused`
#
# Tests hand its path to `RemoteTunnels` the way `EVLAT_SSH` does; the real
# `ssh` is never run from a test.
#
#   FAKE_SSH_LOG          file the master's arguments go to; `<log>.env` gets
#                         the variables it was started with, `<log>.askpass`
#                         one `askpass <exit code> <answer>` line per prompt,
#                         `<log>.calls` every other call's arguments
#   FAKE_SSH_HOME         the "server's" home for calls; none, and a call fails
#   FAKE_SSH_PROMPT1..3   the prompts to ask, in order (none: no prompt)
#   FAKE_SSH_PASSWORD     the password the "server" takes; another answer to a
#                         password prompt is refused (unset: any answer)
#   FAKE_SSH_FAIL         one OpenSSH line to end with instead of connecting;
#                         a call fails with it too
#   FAKE_SSH_FORWARD      `refused`: the forward fails as a server that allows
#                         no socket forwarding makes it fail
#   FAKE_SSH_MARK         `none`: the master never prints its mark
#
# A refused prompt ends it as OpenSSH does: `Host key verification failed.`
# for a yes/no question, `Permission denied` for anything else.

# `--evlat-warm`: exit before anything else (FreshExecutable).
[ "$1" = --evlat-warm ] && exit 0

log="${FAKE_SSH_LOG:-/dev/null}"
eval "last=\${$#}"
mode=master
for a in "$@"; do
  [ "$a" = -O ] && mode=forward
done
[ "$mode" = master ] && [ "$last" = "sh -s" ] && mode=call

if [ "$mode" != master ]; then
  [ "$log" = /dev/null ] || { echo '--- run'; for a in "$@"; do printf '%s\n' "$a"; done; } >> "$log.calls"
  if [ -n "${FAKE_SSH_FAIL-}" ]; then
    echo "$FAKE_SSH_FAIL" >&2
    exit 255
  fi
  if [ "$mode" = forward ]; then
    if [ "${FAKE_SSH_FORWARD-}" = refused ]; then
      echo "mux_client_forward: forwarding request failed: remote port forwarding failed for listen path ${last}" >&2
      echo 'muxclient: master forward request failed' >&2
      exit 255
    fi
    exit 0
  fi
  if [ -z "${FAKE_SSH_HOME-}" ]; then
    echo 'fake-ssh: FAKE_SSH_HOME is not set: no server to run on' >&2
    exit 255
  fi
  HOME=$FAKE_SSH_HOME
  export HOME
  exec sh -s
fi

{ echo '--- run'; for a in "$@"; do printf '%s\n' "$a"; done; } >> "$log"
printf '%s\n' "SSH_AUTH_SOCK=${SSH_AUTH_SOCK-}" \
  "SSH_ASKPASS=${SSH_ASKPASS-unset}" \
  "SSH_ASKPASS_REQUIRE=${SSH_ASKPASS_REQUIRE-unset}" \
  "EVLAT_ASKPASS=${EVLAT_ASKPASS:+set}" >> "$log.env"

denied='Permission denied (publickey,password).'
for n in 1 2 3; do
  eval "prompt=\${FAKE_SSH_PROMPT$n-}"
  [ -n "$prompt" ] || break
  # The helper's streams are not the tunnel's: its stdin is nobody's.
  answer=$("$SSH_ASKPASS" "$prompt" </dev/null)
  code=$?
  printf 'askpass %s %s\n' "$code" "$answer" >> "$log.askpass"
  case "$prompt" in
    *yes/no*)
      if [ "$code" -ne 0 ] || [ "$answer" != yes ]; then
        echo 'Host key verification failed.' >&2
        exit 255
      fi ;;
    *)
      if [ "$code" -ne 0 ]; then echo "$denied" >&2; exit 255; fi
      if [ -n "${FAKE_SSH_PASSWORD+set}" ] && [ "$answer" != "$FAKE_SSH_PASSWORD" ]; then
        echo "$denied" >&2
        exit 255
      fi ;;
  esac
done

if [ -n "${FAKE_SSH_FAIL-}" ]; then
  echo "$FAKE_SSH_FAIL" >&2
  exit 255
fi
# The remote command, here: the mark, then `cat` on the pipe Evlat holds.
if [ "${FAKE_SSH_MARK-}" = none ]; then exec cat >/dev/null; fi
exec sh -c "$last"
