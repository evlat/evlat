/* Evlat — the source language. Every key here is in tr.lproj too, in the same
   order; context comments live only in this table. */

/* The grey line under a session's name on the open bar: "{status} · {time}".
   A row first seen in its phase has no time and shows the status alone. */
"status.line" = "{status} · {time}";

/* A session's phase, as the status line says it. */
"status.idle" = "idle";
"status.working" = "working";
"status.review" = "done";
"status.failed" = "error";
/* Waiting, when the source did not say on what (a session file). */
"status.waiting" = "waiting";
/* Waiting for a yes/no on a tool. */
"status.waiting.approval" = "waiting for approval";
/* Waiting for words: the agent asked a question. */
"status.waiting.answer" = "waiting for an answer";
/* A remote row whose machine cannot be heard: no tunnel, or not heard from
   since it came back. Shown in place of the phase, as "{status} · {time}". */
"row.unreachable" = "no connection";
/* A remote row that was working and has said nothing for half an hour. */
"row.silent" = "quiet";

/* How long the session has been in its phase. Under a minute: */
"time.justNow" = "just now";
"time.minutes" = "{count} min";
"time.hours" = "{count} h";
"time.days" = "{count} d";

/* The detail card's header: the tool the session runs in. */
"source.claude" = "Claude Code";
"source.codex" = "Codex";
/* The card's footer: tools started in this turn. A count that began mid-turn
   is shown with a leading "~". */
"card.tools.one" = "1 tool";
"card.tools" = "{count} tools";
/* The card's button: brings the session's terminal app forward. */
"card.go" = "Go to session";
/* The button, dimmed, when the session's app is not running. It is never opened. */
"card.closed" = "{app} is closed";
/* The button, dimmed, when no app was found for the session: screen, tmux, ssh. */
"card.notFound" = "Terminal not found";

/* The line under the open list: how many sessions, and how many of them are
   working. With none working it is the first part alone. */
"summary.line" = "{sessions} · {working}";
"summary.sessions.one" = "1 session";
"summary.sessions" = "{count} sessions";
"summary.working" = "{count} working";

/* The usage block under the open list: one group per source, one line per
   rate-limit window. Compact units, for a table's column: a window's name
   ("5h", "7d") and the time left ("1h 12m") are built from them. */
"usage.unit.minutes" = "{count}m";
"usage.unit.hours" = "{count}h";
"usage.unit.days" = "{count}d";
/* Two units of one span: "1h 12m". */
"usage.pair" = "{first} {second}";
/* How much of the window is used. A reading Evlat derived is shown with a
   leading "~". */
"usage.percent" = "{value}%";
/* Time left until the window starts over. */
"usage.resets" = "↻ {time}";
/* In place of the countdown, when the reading is over an hour old. */
"usage.ago" = "{time} ago";

/* The menu: the mascot's right click, and the menu-bar icon's. The edge the
   bar is docked to, with its two choices. */
"menu.edge" = "Edge";
"menu.edge.right" = "Right";
"menu.edge.left" = "Left";
"menu.quit" = "Quit Evlat";
/* The menu-bar icon's only: a diagnostic that fixes the mascot on one phase
   (the phases are the status line's words), and the entry that lets it go. */
"menu.force" = "Force state";
"menu.force.follow" = "Follow sessions";

/* The hook entries, one per agent whose folder exists. {source} is the
   agent's name (source.claude, source.codex). The title says what a click
   does: the hooks are not there, differ from today's, or are current. */
"menu.hooks.install" = "Install {source} hooks";
"menu.hooks.update" = "Update {source} hooks";
"menu.hooks.remove" = "Remove {source} hooks";
/* An entry's tooltip: what the agent needs after the write. */
"menu.hooks.hint.claude" = "In open Claude Code sessions, open /hooks once to load the change.";
"menu.hooks.hint.codex" = "Codex asks you to trust the new hooks.";
"menu.hooks.hint.remove" = "Codex may ask again to trust your other hooks.";
/* A refused write: one dim line under the entry, until a write succeeds.
   The file is left as it was in every case. */
"menu.hooks.error.unreadable" = "The settings file could not be read";
"menu.hooks.error.malformed" = "The settings file is not in a form Evlat can edit; left as is";
"menu.hooks.error.noDirectory" = "The agent's folder is gone";
"menu.hooks.error.changedUnderneath" = "The file changed while writing; try again";
"menu.hooks.error.unwritable" = "The settings file could not be written";

/* The usage line entry, under Claude Code's hook entry: it wraps the user's
   status line command so its JSON also reaches Evlat. A wrapper changed by
   hand is a dim line with no action. A refused write shows the hooks' lines. */
"menu.usage.install" = "Install the usage line";
"menu.usage.remove" = "Remove the usage line";
"menu.usage.modified" = "Usage line edited by hand";
"menu.usage.hint" = "Wraps your Claude Code status line; open sessions relay usage from their next message.";

/* The remote machines: servers reached over ssh whose sessions show on the
   bar. The menu's entry opens the window; under it, one dim line per machine
   whose connection failed: "{machine}: {failure}" (remote.failure.*). */
"menu.remote" = "Remote Machines…";
"menu.remote.failure" = "{machine}: {failure}";

/* The window. With no machine it shows an invitation and the field. */
"remote.window.title" = "Remote Machines";
"remote.empty.title" = "No remote machines yet";
"remote.empty.body" = "Sessions you run on a server over ssh can show up on the bar like local ones. Add the server by the name you give ssh — an alias from ~/.ssh/config such as devbox, or me@server.";
"remote.empty.requirement" = "Needs passwordless ssh, and to have connected once from Terminal.";
/* The field: an ssh target. The button adds it; Return does too. */
"remote.add.placeholder" = "devbox or me@server";
"remote.add" = "Add";
/* Why a target is refused, one line under the field. */
"remote.add.empty" = "Type the name you give ssh.";
"remote.add.option" = "A name can't start with “-”.";
"remote.add.invalidCharacter" = "A name can't contain spaces.";
"remote.add.duplicate" = "{name} is already added.";
/* When Evlat was started with EVLAT_MACHINES or EVLAT_PORT (a test run):
   the list is not stored. */
"remote.environment" = "Started with EVLAT_MACHINES or EVLAT_PORT: machines added or removed here are forgotten when Evlat quits.";

/* A machine's connection, under its name. {sessions} is summary.sessions*. */
"remote.state.stopped" = "not connected";
"remote.state.connecting" = "connecting…";
"remote.state.connected" = "connected";
"remote.state.connected.sessions" = "connected · {sessions}";
/* A failed connection: what went wrong, and when the next try is. */
"remote.state.waiting" = "{failure} · {retry}";
"remote.retry" = "retrying in {time}";
"remote.retry.soon" = "retrying shortly";
/* What went wrong (also the menu's line), then what to do about it.
   {target} is what the machine was added as. */
"remote.failure.authentication" = "sign-in refused";
"remote.failure.authentication.advice" = "Evlat needs passwordless ssh: a key the server accepts, loaded in your agent. Check that “ssh {target}” logs in from Terminal without asking.";
"remote.failure.portBusy" = "port 48151 is taken on the server";
"remote.failure.portBusy.advice" = "The server may still hold an old connection; it usually lets go within a minute. Another user's Evlat on the same server can hold it too.";
"remote.failure.hostKey" = "unknown host key";
"remote.failure.hostKey.advice" = "Connect once from Terminal with “ssh {target}” and accept the host key.";
"remote.failure.hostName" = "host not found";
"remote.failure.hostName.advice" = "Check the name, or its Host entry in ~/.ssh/config.";
"remote.failure.unreachable" = "server unreachable";
"remote.failure.unreachable.advice" = "Check the network or the VPN; Evlat keeps trying.";
"remote.failure.other" = "ssh failed";
"remote.failure.other.advice" = "Run “ssh {target}” in Terminal to see why.";

/* Setting the server up: two ways, always both offered. */
"remote.setup" = "Setup on the server";
"remote.setup.automatic" = "Automatically";
"remote.setup.manual" = "By hand";
"remote.auto.body" = "Evlat connects over ssh and edits the server's settings files with the same writer as this Mac's menu: it never creates a missing folder, keeps a copy of the first version, and leaves a file alone if it changed meanwhile.";
"remote.auto.hooks.install" = "Install or update hooks";
"remote.auto.hooks.remove" = "Remove hooks";
"remote.auto.usage.install" = "Install the usage line";
"remote.auto.usage.remove" = "Remove the usage line";
"remote.auto.busy" = "Working on {name}…";
/* The result line: one "{change}: {result}" per file, joined with " · ".
   {change} is source.* or remote.change.usage. */
"remote.result.part" = "{change}: {result}";
"remote.change.usage" = "Usage line";
"remote.result.installed" = "installed";
"remote.result.removed" = "removed";
"remote.result.current" = "already up to date";
"remote.result.absent" = "nothing to remove";
"remote.result.noDirectory" = "not installed (no folder)";
"remote.result.unreadable" = "the file could not be read";
"remote.result.malformed" = "the file is not in a form Evlat can edit; left as is";
"remote.result.changedUnderneath" = "the file changed while writing; try again";
"remote.result.unwritable" = "the file could not be written";
/* Alone, when ssh could not reach the server at all. */
"remote.result.unreachable" = "Could not reach the server; nothing was changed.";

/* By hand: exactly what the automatic setup writes, to paste yourself.
   {placeholder} is the word to replace with your own command. */
"remote.manual.body" = "Prefer to see every change first — on a production server, say? Paste these yourself; they are byte for byte what the automatic setup writes. Each hook only sends the event to 127.0.0.1:48151 on the server, fails silently and prints nothing; the tunnel brings it to this Mac.";
"remote.manual.claude" = "~/.claude/settings.json — merge this “hooks” block into the file, next to any hooks you already have:";
"remote.manual.codex" = "~/.codex/hooks.json — the same for Codex, if it is on the server:";
"remote.manual.statusLine" = "The usage line — if settings.json has no “statusLine” yet, add this:";
"remote.manual.wrapping" = "If it already has one, keep it and set its “command” to this, with your command in place of {placeholder} (a ' inside it is written '\\''):";
"remote.manual.remove" = "To remove: delete every entry whose command contains {marker}, and put your statusLine command back. If the automatic setup changed a file, its first version is in the same folder with .evlat.bak added to the name.";
"remote.manual.surface" = "What this opens: any process on the server can write to Evlat through the tunnel. If another user on the server holds port 48151 first, your events go to their Mac. With GatewayPorts yes in the server's sshd_config, the port opens to the server's network.";
"remote.copy" = "Copy";
"remote.copied" = "Copied";

/* Removing a machine: asked in the window first. */
"remote.remove" = "Remove Machine…";
"remote.remove.confirm" = "Remove {name}? The tunnel closes and its sessions leave the bar. Hooks on the server stay where they are and fall silent with no one listening — to take them out first, use Remove hooks.";
"remote.remove.cancel" = "Cancel";
"remote.remove.do" = "Remove";

